; Skyrise, the Godot port. See README.md.
config_version=5

[application]

config/name="Skyrise"
config/description="An original touch-first tower sim."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/art/app-icon-512.png"

[display]

window/size/viewport_width=360
window/size/viewport_height=740
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=false

[gui]

theme/default_font_antialiasing=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.933, 0.945, 0.961, 1)
